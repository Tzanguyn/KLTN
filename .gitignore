# Dependencies
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (keep example files)
.env
.env.*
!.env.example
!.env.template

# Build outputs & compile caches
dist/
**/dist/
build/
**/build/
out/
.next/
*.tsbuildinfo
**/*.tsbuildinfo

# Uploads & local storage (keep folder structure via .gitkeep)
uploads/*
**/uploads/*
!uploads/.gitkeep
!**/uploads/.gitkeep

# Backup files (e.g. Visual Paradigm backups)
*.bak
*.bak_*
*.vpp.bak_*

# Local history & Editor / IDE files
.history/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
